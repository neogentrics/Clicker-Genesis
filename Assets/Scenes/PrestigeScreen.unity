  m_Script: {fileID: 11500000, guid: cd6877434cf61174db6a83bf6a31984b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClickerGenesis.Core.DescriptionBoxHover
  Target: {fileID: 1336436368}
  Text: 'Reset Prestige: grants 2.5x the Grace of a free Prestige, but wipes Ink,
    Click Power, Level/XP, and scribe owned counts back to the start. Permanently
    raises verse/chapter/book XP, makes tapping and buying scribes grant XP for the
    first time, adds +0.5 Ink/sec base income, and (once you''ve completed a book)
    a growing Ink multiplier - all stack with every reset you do. Unlocks the tree''s
    biggest capstone skills too. Unlocked verses/chapters/books are NEVER lost either
    way.'
