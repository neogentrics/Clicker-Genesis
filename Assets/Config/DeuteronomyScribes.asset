  bookName: Deuteronomy
  tiers:
  - id: unworn_sandal
    displayName: Unworn Sandal
    flavorText: '''Thy raiment waxed not old upon thee... these forty years.'''
    tierType: 1
    purpose: A deliberate historical recap, not a repeat for its own sake - reminds
      the new generation of the spies' failure at Kadesh-barnea, the defeats of Sihon
      and Og, and the golden calf, specifically so they don't repeat their parents'
      unbelief now that they're the ones about to cross in.
    deliveredByManagerId: moses
    managerId: wilderness_lessons
