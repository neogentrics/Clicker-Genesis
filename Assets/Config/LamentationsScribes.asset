  bookName: Lamentations
  tiers:
  - id: jerusalems_desolation_lament
    displayName: The Weeping Widow (Jerusalem's Desolation)
    flavorText: Personifies Jerusalem as a bereaved widow weeping in the night with
      no one to comfort her, while conceding that the LORD's judgment upon her is
      deserved.
    tierType: 1
    purpose: Personifies Jerusalem/Zion as a great city fallen to the status of a
      bereaved widow, weeping in the night with no comforter, while the poem repeatedly
      concedes the judgment is deserved.
    deliveredByManagerId: 
    managerId: jerusalems_desolation_lament
