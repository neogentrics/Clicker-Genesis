    managerUnlockCost: 0
    submanagers: []
  - id: sanctify_them_in_truth
    displayName: Sanctify Them In Truth
    flavorText: Jesus prays aloud for his disciples and all future believers, asking
      the Father to 'sanctify them through thy truth.'
    tierType: 1
    purpose: "On the eve of his arrest, Jesus prays aloud in the hearing of his disciples
      \u2014 for himself, for his immediate followers, and for all who would later
      believe through their word \u2014 a prayer for unity, protection, and sanctification
      rather than a teaching addressed to people directly."
    deliveredByManagerId: jesus_john
    managerId: high_priestly_prayer_john
