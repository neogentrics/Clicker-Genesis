    submanagers: []
  - id: lest_he_be_swallowed_up
    displayName: Lest He Be Swallowed Up
    flavorText: Paul declares the church's punishment of the offender sufficient
      and urges them to forgive and comfort him, lest he be swallowed up by overmuch
      sorrow.
    tierType: 1
    purpose: "Balances church discipline with restoration for a member who caused
      grief \u2014 the punishment already given is sufficient, and forgiveness and
      comfort should follow so godly sorrow leads to repentance, not despair."
    deliveredByManagerId: paul_2cor
    managerId: offender_discipline_law
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 1643.1676725154985
