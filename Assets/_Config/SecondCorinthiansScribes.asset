    submanagers: []
  - id: angels_of_light
    displayName: Angels of Light
    flavorText: Paul warns that Satan himself is transformed into an angel of light,
      so it is no surprise that false apostles disguise themselves as ministers of
      righteousness.
    tierType: 1
    purpose: Warns the Corinthian church against rival teachers preaching another
      Jesus and commending themselves, exposing their self-commendation as counterfeit
      ministry since true apostleship is marked by suffering and weakness, not self-promotion.
    deliveredByManagerId: paul_2cor
    managerId: false_apostles_law
