    submanagers: []
  - id: the_veil_taken_away
    displayName: The Veil Taken Away
    flavorText: Paul contrasts Moses' fading, veiled glory under the old covenant
      with the unveiled and ever-increasing glory of the new covenant of the Spirit.
    tierType: 1
    purpose: Contrasts the old covenant's fading, veiled glory with the new covenant
      of the Spirit's unveiled and increasing glory, explaining how suffering apostles
      still carry surpassing power that is of God, not of themselves.
    deliveredByManagerId: paul_2cor
    managerId: new_covenant_unveiled_glory_law
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 5883.047468624995
