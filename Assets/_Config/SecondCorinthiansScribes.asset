    submanagers: []
  - id: ambassadors_for_christ
    displayName: Ambassadors for Christ
    flavorText: Paul declares that God has given believers the ministry of reconciliation,
      making them ambassadors for Christ who plead with the world to be reconciled
      to God.
    tierType: 1
    purpose: Teaches the apostolic calling to carry God's message of reconciliation
      to the world, grounded in hope beyond the earthly body and the truth that anyone
      in Christ is a new creature.
    deliveredByManagerId: paul_2cor
    managerId: ministry_of_reconciliation_law
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
