  - id: mystery_manifest
    displayName: The Mystery Made Manifest
    flavorText: 'Paul rejoices in his sufferings as steward of the long-hidden mystery
      now revealed: Christ in you, the hope of glory.'
    tierType: 1
    purpose: "Explains Paul's own suffering and ministry as steward of a long-hidden
      'mystery' \u2014 Christ dwelling in the Gentiles as the hope of glory \u2014
      grounding his authority to warn a church he has never personally visited."
    deliveredByManagerId: paul_colossians
    managerId: mystery_manifest_col
