    submanagers: []
  - id: the_perilous_times
    displayName: The Perilous Times
    flavorText: Paul warns that in the last days perilous times will come, marked
      by people who hold a form of godliness while denying its power, and instructs
      Timothy to turn away from them.
    tierType: 1
    purpose: Warns Timothy of the moral and spiritual character of people in the
      last days, instructing him to have nothing to do with such people while reassuring
      him that their deception has a real, appointed limit.
    deliveredByManagerId: paul_2timothy
    managerId: perilous_times_2timothy
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 7611.662611020245
