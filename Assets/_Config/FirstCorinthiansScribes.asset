    managerUnlockCost: 0
    submanagers: []
  - id: ye_are_bought_with_a_price
    displayName: Ye Are Bought With a Price
    flavorText: Paul rebukes believers for suing one another before unbelieving judges
      and calls the body a temple of the Holy Ghost, purchased at a price and not
      to be given to fornication.
    tierType: 1
    purpose: Covers believers taking legal disputes against one another before secular
      judges instead of resolving them within the church, and warns against sexual
      immorality on the grounds that the believer's body is a member of Christ and
      a temple of the Holy Ghost.
    deliveredByManagerId: paul
    managerId: lawsuits_and_the_temple
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 226.7535954067496
    costGrowthRate: 1.15
