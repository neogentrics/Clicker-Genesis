    managerUnlockCost: 0
    submanagers: []
  - id: instructions_on_marriage
    displayName: Instructions on Marriage
    flavorText: Paul answers the Corinthians' written questions on marriage, celibacy,
      and mixed marriages, teaching that each believer should remain content in whatever
      state they were called.
    tierType: 1
    purpose: Answers questions the Corinthians had written to Paul about marriage,
      celibacy, divorce, and marriages between believers and unbelievers, teaching
      that both marriage and singleness are legitimate callings and each should remain
      content in the state in which they were called.
    deliveredByManagerId: paul
    managerId: marriage_instructions
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 641.8086646779358
    costGrowthRate: 1.15
