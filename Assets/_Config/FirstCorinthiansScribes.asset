    submanagers: []
  - id: one_should_have_his_fathers_wife
    displayName: One Should Have His Father's Wife
    flavorText: Paul confronts a case of sexual immorality the church had tolerated
      rather than mourned, directing that the unrepentant man be removed from fellowship
      for his own eventual restoration.
    tierType: 1
    purpose: 'Addresses a reported case of sexual immorality within the church that
      the congregation had tolerated rather than mourned, establishing a principle
      of church discipline: removing the unrepentant offender from fellowship both
      to protect the body and for the offender''s own restoration.'
    deliveredByManagerId: paul
    managerId: unrepentant_brother
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 80.11296179008338
    costGrowthRate: 1.15
