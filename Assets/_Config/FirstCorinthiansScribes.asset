    submanagers: []
  - id: meat_offered_unto_idols
    displayName: Meat Offered Unto Idols
    flavorText: Paul teaches that an idol is nothing in itself, yet urges the strong
      to restrain their liberty out of love for a weaker believer's conscience.
    tierType: 1
    purpose: Works through the disputed question of eating meat sacrificed to idols,
      teaching that love for a weaker believer's conscience should restrain a stronger
      believer's liberty, and contrasting the Lord's table with pagan sacrificial
      meals.
    deliveredByManagerId: paul
    managerId: meat_offered_to_idols
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 1816.5902124584957
