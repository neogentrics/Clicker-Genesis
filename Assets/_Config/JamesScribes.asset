    submanagers: []
  - id: respect_of_persons
    displayName: Respect of Persons Forbidden
    flavorText: 'James rebukes favoritism toward the rich and contempt for the poor
      within the assembly, calling believers instead to the royal law: love thy neighbour
      as thyself.'
    tierType: 1
    purpose: Favoritism toward the rich and contempt for the poor within the assembly
      is condemned; fulfilling the royal law to love one's neighbor as oneself is
      what matters, since mercy rejoices against judgment.
    deliveredByManagerId: james_brother_of_jesus
    managerId: respect_of_persons
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
