    managerUnlockCost: 0
    submanagers: []
  - id: parables_prayer_humility
    displayName: Parables of Prayer and Humility
    flavorText: A widow's persistence wears down an unjust judge, and a publican's
      plea for mercy, not a Pharisee's boasting, is the prayer that goes home justified.
    tierType: 1
    purpose: Two parables told together on how one ought to pray and regard oneself
      before God -- persistence in prayer illustrated by an unjust judge worn down
      by a widow's request, and true humility illustrated by a Pharisee's boasting
      prayer contrasted with a publican's plea for mercy.
    deliveredByManagerId: jesus_luke
    managerId: parables_prayer_humility
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 442735.2762083159
