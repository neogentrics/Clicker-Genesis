  - id: blood_basin
    displayName: Blood Basin
    flavorText: The sin offering - scaled to the offender's own status.
    tierType: 0
    purpose: Addresses unintentional sin, with the required animal scaled to the
      offender's status (priest, whole congregation, ruler, or common person) - teaches
      that sin has real weight regardless of intent, but also that provision for
      it is graded to what each person can actually bring.
    deliveredByManagerId: moses
    managerId: sin_offering
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 154.2
    costGrowthRate: 1.15
    baseInkPerSecond: 7.71
