    submanagers: []
  - id: covenant_ledger
    displayName: Covenant Ledger
    flavorText: Blessings and curses - the nation's future tied to covenant faithfulness.
    tierType: 0
    purpose: Closes the legal core of the book by tying the WHOLE nation's future
      - not just individual behavior - to covenant faithfulness, with real, escalating
      consequences laid out either direction. Functions as the book's own built-in
      stakes statement.
    deliveredByManagerId: moses
    managerId: blessings_curses
    icon: {fileID: 21300000, guid: 166b0fad31272664f8e2dd0876d7af6f, type: 3}
