  - id: altar_flame
    displayName: Altar Flame
    flavorText: The burnt offering - herd, flock, or fowl, wholly consumed.
    tierType: 0
    purpose: Wholly consumed on the altar - nothing kept back for the offerer. Teaches
      total, unreserved surrender/devotion to God as the starting posture for approaching
      a holy God at all.
    deliveredByManagerId: moses
    managerId: burnt_offering
