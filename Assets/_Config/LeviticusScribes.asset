    submanagers: []
  - id: cloven_hoof
    displayName: Cloven Hoof
    flavorText: Clean and unclean animals - a daily reminder woven into every meal.
    tierType: 0
    purpose: Dietary law - animals that both chew the cud and part the hoof are clean.
      Functions as a constant, daily, embodied reminder that Israel is set apart
      from the surrounding nations, woven into something as ordinary as every meal.
    deliveredByManagerId: moses
    managerId: clean_unclean_animals
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 676.9
