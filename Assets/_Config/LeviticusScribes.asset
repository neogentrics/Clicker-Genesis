  - id: restitution_scale
    displayName: Restitution Scale
    flavorText: The trespass offering - restitution plus a fifth part added.
    tierType: 0
    purpose: Specifically for sins involving damage or deception against God or a
      neighbor - requires restitution PLUS a fifth added on top, not just a sacrifice.
      Teaches that wronging someone isn't fixed by ritual alone; the actual harm
      has to be repaid.
    deliveredByManagerId: moses
    managerId: trespass_offering
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 323.1
    costGrowthRate: 1.15
    baseInkPerSecond: 16.15
