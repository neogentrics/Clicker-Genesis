    isBookWidePatron: 0
    managerUnlockCost: 39137.1
    submanagers: []
  - id: jubilee_trumpet
    displayName: Jubilee Trumpet
    flavorText: The Year of Jubilee - land and liberty restored every fiftieth year.
    tierType: 0
    purpose: Every 50th year, land returns to its original family and debt-slaves
      go free - a hard economic reset built into the calendar itself. Teaches that
      the land ultimately belongs to God ('the land is mine,' 25:23), not to whoever
      has accumulated it, and that no family's poverty is meant to become permanent
      and inherited.
    deliveredByManagerId: moses
    managerId: jubilee
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 27334.2
    costGrowthRate: 1.15
    baseInkPerSecond: 1366.71
