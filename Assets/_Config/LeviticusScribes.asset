    managerUnlockCost: 8914.8
    submanagers: []
  - id: golden_lampstand
    displayName: Golden Lampstand
    flavorText: Priestly regulations and the tabernacle's ever-burning lamp.
    tierType: 0
    purpose: Sets stricter purity standards for priests than for ordinary Israelites
      since they mediate directly at the altar, then turns to the tabernacle's ongoing
      daily/weekly maintenance (the lamp, the showbread) - closing with a real test
      of how the holiness laws apply even to a mixed-heritage member of the camp.
    deliveredByManagerId: moses
    managerId: priestly_regulations
    icon: {fileID: 21300000, guid: 436d4f3d224723240b3d522638853155, type: 3}
    managerIcon: {fileID: 0}
