    submanagers: []
  - id: feast_scroll
    displayName: Feast Scroll
    flavorText: The seven feasts - Israel's year bound to the LORD's own acts.
    tierType: 0
    purpose: A full annual calendar binding the nation's sense of time itself to
      God's actions - deliverance (Passover, Unleavened Bread), harvest and provision
      (Firstfruits, Weeks), and a run of autumn feasts (Trumpets, Atonement, Tabernacles)
      closing the year by re-centering the whole community on God rather than the
      harvest alone.
    deliveredByManagerId: moses
    managerId: seven_feasts
    icon: {fileID: 21300000, guid: 1690703e7befc87448bdeb9224bd3d97, type: 3}
    managerIcon: {fileID: 0}
    baseCost: 13045.7
    costGrowthRate: 1.15
