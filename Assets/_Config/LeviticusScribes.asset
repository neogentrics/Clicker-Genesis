  - id: fellowship_portion
    displayName: Fellowship Portion
    flavorText: The peace offering - a shared meal representing restored fellowship.
    tierType: 0
    purpose: The only offering where the offerer eats part of the meat themselves,
      alongside the priest's portion and God's portion (the fat, burnt on the altar)
      - a shared meal representing restored fellowship, not just atonement.
    deliveredByManagerId: moses
    managerId: peace_offering
    icon: {fileID: 21300000, guid: c6c123e4d01616548a61a57830f67a07, type: 3}
