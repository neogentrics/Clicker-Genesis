    submanagers: []
  - id: god_is_love
    displayName: God Is Love
    flavorText: He declares that God's very nature is love, shown by sending his
      only begotten Son as propitiation, and that believers must love one another
      because God first loved them.
    tierType: 1
    purpose: "The letter's central theological statement \u2014 that God's very nature
      is love, demonstrated concretely in sending his only begotten Son so that believers
      'might live through him' and have their sins propitiated; because God loved
      first, believers are commanded to love one another, God's love is 'perfected'
      in that mutual love, and 'perfect love casteth out fear.'"
    deliveredByManagerId: author_1_john
    managerId: god_is_love
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 27752.26636992245
