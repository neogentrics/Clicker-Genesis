  bookName: 1 John
  tiers:
  - id: the_eyewitness
    displayName: The Eyewitness
    flavorText: An unnamed eyewitness declares what he has heard, seen with his own
      eyes, and touched with his own hands concerning the Word of life, so that his
      readers may share fellowship with him, the Father, and the Son.
    tierType: 0
    purpose: 
    deliveredByManagerId: 
    managerId: author_1_john
