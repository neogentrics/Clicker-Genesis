    submanagers: []
  - id: overcoming_the_world
    displayName: Overcoming the World
    flavorText: He teaches that faith that Jesus is the Christ, born of God, is itself
      the victory that overcomes the world.
    tierType: 1
    purpose: Teaches that faith that Jesus is the Christ, love for God, and love
      for God's children are all inseparably bound together, and that this faith
      itself is 'the victory that overcometh the world.'
    deliveredByManagerId: author_1_john
    managerId: overcoming_the_world
    icon: {fileID: 0}
