    managerUnlockCost: 0
    submanagers: []
  - id: trying_the_spirits
    displayName: Trying the Spirits
    flavorText: He instructs believers not to believe every spirit but to test them
      by whether they confess that Jesus Christ has come in the flesh.
    tierType: 1
    purpose: "Instructs believers not to 'believe every spirit,' but to 'try the
      spirits whether they are of God,' giving a concrete doctrinal test \u2014 confessing
      that Jesus Christ has come in the flesh \u2014 to distinguish the Spirit of
      God/spirit of truth from the spirit of antichrist/spirit of error."
    deliveredByManagerId: author_1_john
    managerId: trying_the_spirits
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 11500.315051230227
