    submanagers: []
  - id: love_not_the_world
    displayName: Love Not the World
    flavorText: He warns against loving the world's lust of the flesh, lust of the
      eyes, and pride of life, since the world passes away but the one who does God's
      will abides forever.
    tierType: 1
    purpose: "Warns against loving 'the world' \u2014 defined specifically as 'the
      lust of the flesh, and the lust of the eyes, and the pride of life' \u2014
      and contrasts the world's passing away with the permanence of one who does
      the will of God."
    deliveredByManagerId: author_1_john
    managerId: love_not_the_world
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 339.12114430141673
