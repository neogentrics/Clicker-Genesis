    submanagers: []
  - id: unity_of_spirit_ephesians
    displayName: The Unity of the Spirit
    flavorText: "The ascended Christ gives gifts to men \u2014 apostles, prophets,
      evangelists, pastors, and teachers \u2014 so the body grows in unity toward
      the fulness of Christ."
    tierType: 1
    purpose: "Calls believers to walk worthy of their calling in humility and unity
      \u2014 \"one body, and one Spirit... one Lord, one faith, one baptism, one
      God and Father of all\" \u2014 grounds that unity in the grace and gifts distributed
      by the ascended Christ, and explains that Christ gave apostles, prophets, evangelists,
      pastors and teachers to equip the saints for ministry and build up the body
      \"till we all come... unto the measure of the stature of the fulness of Christ.\""
    deliveredByManagerId: paul_ephesians
    managerId: unity_of_spirit_ephesians
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 4765.6376785461825
