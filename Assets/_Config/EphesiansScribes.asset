    managerBonusMultiplier: 0.25
    managerUnlockCost: 0
    submanagers: []
  - id: children_of_light_ephesians
    displayName: Walk as Children of Light
    flavorText: Once darkness, now light in the Lord, believers are called to walk
      as children of light and be filled with the Spirit rather than wine.
    tierType: 1
    purpose: "Exhorts believers to \"be followers of God, as dear children\" and
      \"walk in love,\" to have no fellowship with the \"unfruitful works of darkness,\"
      and to be filled with the Spirit rather than drunk with wine \u2014 that fullness
      expressed through singing psalms and hymns and giving thanks, summed up as
      \"submitting yourselves one to another in the fear of God.\""
    deliveredByManagerId: paul_ephesians
    managerId: children_of_light_ephesians
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 27752.26636992245
    costGrowthRate: 1.15
