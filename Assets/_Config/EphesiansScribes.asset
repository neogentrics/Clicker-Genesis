    managerUnlockCost: 0
    submanagers: []
  - id: family_household_ephesians
    displayName: Children, Fathers, Servants, and Masters
    flavorText: Children obey parents under the first commandment with promise, while
      servants and masters alike are told to serve as unto Christ, for God shows
      no respect of persons.
    tierType: 1
    purpose: "Extends the household code to parent-child and master-servant relationships
      \u2014 children obeying parents \"in the Lord\" under \"the first commandment
      with promise,\" fathers not provoking children to wrath, servants serving \"as
      unto Christ\" with singleness of heart, and masters treating servants likewise,
      \"knowing that your Master also is in heaven; neither is there respect of persons
      with him.\""
    deliveredByManagerId: paul_ephesians
    managerId: family_household_ephesians
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 161612.85028745286
    costGrowthRate: 1.15
