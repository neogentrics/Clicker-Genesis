    managerBonusMultiplier: 0.25
    managerUnlockCost: 0
    submanagers: []
  - id: whole_armour_of_god_ephesians
    displayName: The Whole Armour of God
    flavorText: "Believers put on the whole armour of God \u2014 truth, righteousness,
      the gospel of peace, faith, salvation, and the sword of the Spirit \u2014 to
      stand against spiritual wickedness in high places."
    tierType: 1
    purpose: "A vivid closing exhortation to spiritual warfare \u2014 the Christian's
      struggle is \"not against flesh and blood, but against principalities, against
      powers, against the rulers of the darkness of this world, against spiritual
      wickedness in high places\" \u2014 met by putting on each piece of \"the whole
      armour of God\" (truth, righteousness, the gospel of peace, faith, salvation,
      and \"the sword of the Spirit, which is the word of God\"), sustained by watchful
      prayer."
    deliveredByManagerId: paul_ephesians
    managerId: whole_armour_of_god_ephesians
