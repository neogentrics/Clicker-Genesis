    managerBonusMultiplier: 0.25
    managerUnlockCost: 0
    submanagers: []
  - id: marriage_household_ephesians
    displayName: Wives, Husbands, and the Great Mystery
    flavorText: Wives submit to husbands as unto the Lord and husbands love wives
      as Christ loved the church, a union Paul declares "a great mystery" pointing
      to Christ and the church.
    tierType: 1
    purpose: "Sets out the household code for marriage \u2014 wives submitting to
      their own husbands \"as unto the Lord,\" husbands loving their wives \"even
      as Christ also loved the church, and gave himself for it\" \u2014 explicitly
      framed as a living picture of Christ and the church: \"this is a great mystery.\""
    deliveredByManagerId: paul_ephesians
    managerId: marriage_household_ephesians
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 66971.05994367859
    costGrowthRate: 1.15
    baseInkPerSecond: 3348.552997183929
