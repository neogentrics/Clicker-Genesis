    submanagers: []
  - id: rooted_grounded_love_ephesians
    displayName: Rooted and Grounded in Love
    flavorText: Paul prays Christ would dwell in their hearts by faith, that they,
      rooted and grounded in love, might comprehend a love that passes knowledge.
    tierType: 1
    purpose: "Paul's prayer that Christ dwell in the saints' hearts by faith, that
      they be \"rooted and grounded in love\" and able to comprehend the vastness
      of Christ's love that \"passeth knowledge\" \u2014 closing in a doxology praising
      the God \"able to do exceeding abundantly above all that we ask or think.\""
    deliveredByManagerId: paul_ephesians
    managerId: rooted_grounded_love_ephesians
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 1974.8417658131502
