    submanagers: []
  - id: old_man_new_man_ephesians
    displayName: Put Off the Old Man
    flavorText: Paul calls believers to put off the corrupt old man and put on the
      new man, created after God in righteousness and true holiness.
    tierType: 1
    purpose: "A direct call to abandon the former \"vanity\" of Gentile life, be
      \"renewed in the spirit of your mind,\" and \"put on the new man, which after
      God is created in righteousness and true holiness\" \u2014 worked out in concrete
      instructions against lying, unresolved anger, theft, and corrupt speech, and
      a warning not to \"grieve the holy Spirit of God.\""
    deliveredByManagerId: paul_ephesians
    managerId: old_man_new_man_ephesians
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 11500.315051230227
    costGrowthRate: 1.15
