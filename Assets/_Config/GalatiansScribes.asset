    submanagers: []
  - id: sowing_to_the_spirit
    displayName: Sowing to the Spirit
    flavorText: Paul instructs the Galatians to bear one another's burdens, restore
      those overtaken in fault with meekness, and warns that whatsoever a man sows,
      that shall he also reap.
    tierType: 1
    purpose: Practical instruction for community life among believers - restoring
      those overtaken in fault, sharing one another's burdens, supporting teachers,
      and the principle that what a person sows determines what they will reap.
    deliveredByManagerId: paul_galatians
    managerId: burdens_sowing_galatians
