    submanagers: []
  - id: the_fruit_of_the_spirit
    displayName: The Fruit of the Spirit
    flavorText: Paul contrasts the works of the flesh with the fruit of the Spirit
      - love, joy, peace, longsuffering, gentleness, goodness, faith, meekness, temperance
      - and calls believers to walk in the Spirit.
    tierType: 1
    purpose: Contrasts the visible outcomes of living by sinful human nature with
      the character produced by the Holy Spirit, instructing believers to walk in
      the Spirit rather than gratify the flesh.
    deliveredByManagerId: paul_galatians
    managerId: fruit_of_spirit_galatians
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 25364.015159478
