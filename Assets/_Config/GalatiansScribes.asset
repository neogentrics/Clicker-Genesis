    submanagers: []
  - id: abba_father
    displayName: Abba, Father
    flavorText: Paul explains that believers, freed from the law's temporary guardianship,
      receive adoption as sons who cry "Abba, Father," and warns the Galatians not
      to return to bondage.
    tierType: 1
    purpose: Explains the temporary, preparatory role of the Mosaic law relative
      to God's promise to Abraham, describes believers' adoption as sons and heirs
      through Christ, and contrasts bondage under the law with freedom in Christ
      via the allegory of Hagar and Sarah.
    deliveredByManagerId: paul_galatians
    managerId: law_freedom_sonship_galatians
    icon: {fileID: 0}
    managerIcon: {fileID: 0}
    baseCost: 3574.0736945012754
