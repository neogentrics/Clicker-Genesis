    submanagers: []
  - id: the_silver_cord
    displayName: The Silver Cord
    flavorText: Urges the young to remember their Creator before the silver cord
      is loosed and the golden bowl is broken, and the dust returns to earth and
      the spirit to God.
    tierType: 1
    purpose: An extended poem picturing the body's decline into old age and death,
      urging the young to remember and honor their Creator before these losses arrive
      and the spirit returns to the God who gave it.
    deliveredByManagerId: the_preacher
    managerId: remember_thy_creator
